+/* Diagnostic: dump the arbiter PPID map so the real PMIC peripherals
+ * (PM8998 PON at 0x001, GPIO at 0x010) can be identified on hardware. */
+static void
+keys_scan(uint32_t count)
+{
+	printf("SWEET KEYS: SPMI scan arb=%#x apids=%u\n", keys_version, count);
+	for (uint32_t i = 0; i < count && i < 128; ++i) {
+		uint32_t map = keys_rd(keys_core, 0x900u + 4u * i);
+		if (map == 0) {
+			continue;
+		}
+		uint32_t ppid = (map >> 8) & 0xfffu;
+		uint32_t owner = keys_rd(keys_cnfg, 0x700u + 4u * i) & 7u;
+		printf("SWEET KEYS: apid=%u ppid=%#x owner=%u\n", i, ppid, owner);
+	}
 }
 
